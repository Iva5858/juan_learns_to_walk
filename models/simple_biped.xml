<!--
  Placeholder for Juan (MECE 4611 biped), built from the spec slide and BoM:
    height 428 mm, body 142 x 107 mm, feet 168 mm across, leg 232 mm
    (thigh 100 + shin 100 + ankle 32), 8 x HTD-35H, total 1.74 kg.
  Masses per link: pelvis 643 g (PLA, both LiPos, regulator, IMU, hip-roll servos),
  head 233 g (Pi 4, debug board, camera), hip 126 g, thigh 137 g, shin 135 g, foot 36 g.
  Replace with the Onshape export; see README "Bring in your model".

  Conventions the RL env relies on (keep them in your own model):
    * the root body has a <freejoint/> (floating base)
    * one actuator per driven joint (type does not matter, the env drives them as servos)
    * foot bodies named as in RobotConfig.foot_bodies
    * a keyframe named "home" with the nominal standing pose
  Joint signs: hip pitch negative = leg forward, knee positive = shin back (human-like).
-->
<mujoco model="juan_placeholder">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <!-- armature: reflected rotor inertia of a geared hobby servo; damping/frictionloss: gearbox -->
    <joint damping="0.02" armature="0.001" frictionloss="0.02"/>
    <!-- nominal friction ~ rubber sole on a typical indoor floor; training randomizes 0.5-1.2 -->
    <geom friction="0.8 0.005 0.0001" rgba="0.75 0.75 0.8 1"/>
    <!-- Only used when the model is viewed on its own; the env replaces these with its servo model -->
    <position kp="15" inheritrange="1" forcerange="-3.43 3.43"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.2 0.3 0.4" rgb2="0.3 0.4 0.5"/>
    <material name="grid" texture="grid" texrepeat="16 16" reflectance="0.1"/>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0 0 0" width="512" height="512"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>

    <!-- body origin = pelvis centre -->
    <body name="torso" pos="0 0 0.31">
      <freejoint name="root"/>
      <geom name="pelvis" type="box" size="0.0535 0.071 0.04" mass="0.643" rgba="0.55 0.55 0.6 1"/>
      <geom name="head" type="box" pos="0 0 0.0765" size="0.0435 0.061 0.0365" mass="0.233" rgba="0.7 0.7 0.75 1"/>
      <site name="imu" pos="0 0 0.09"/>

      <body name="l_hip" pos="0 0.059 -0.048">
        <joint name="l_hip_roll" axis="1 0 0" range="-23 23"/>
        <geom type="box" pos="0 0 -0.018" size="0.022 0.022 0.018" mass="0.126"/>
        <body name="l_thigh" pos="0 0 -0.035">
          <joint name="l_hip_pitch" axis="0 1 0" range="-96 92"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.1" size="0.02" mass="0.137"/>
          <body name="l_shin" pos="0 0 -0.1">
            <joint name="l_knee" axis="0 1 0" range="-92 108"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.1" size="0.019" mass="0.135"/>
            <body name="l_foot" pos="0 0 -0.1">
              <joint name="l_ankle" axis="0 1 0" range="-80 76"/>
              <geom name="l_foot" type="box" pos="0.01 0 -0.026" size="0.045 0.025 0.006" mass="0.036"/>
            </body>
          </body>
        </body>
      </body>

      <body name="r_hip" pos="0 -0.059 -0.048">
        <joint name="r_hip_roll" axis="1 0 0" range="-23 23"/>
        <geom type="box" pos="0 0 -0.018" size="0.022 0.022 0.018" mass="0.126"/>
        <body name="r_thigh" pos="0 0 -0.035">
          <joint name="r_hip_pitch" axis="0 1 0" range="-96 92"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.1" size="0.02" mass="0.137"/>
          <body name="r_shin" pos="0 0 -0.1">
            <joint name="r_knee" axis="0 1 0" range="-92 108"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.1" size="0.019" mass="0.135"/>
            <body name="r_foot" pos="0 0 -0.1">
              <joint name="r_ankle" axis="0 1 0" range="-80 76"/>
              <geom name="r_foot" type="box" pos="0.01 0 -0.026" size="0.045 0.025 0.006" mass="0.036"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="l_hip_roll" joint="l_hip_roll"/>
    <position name="l_hip_pitch" joint="l_hip_pitch"/>
    <position name="l_knee" joint="l_knee"/>
    <position name="l_ankle" joint="l_ankle"/>
    <position name="r_hip_roll" joint="r_hip_roll"/>
    <position name="r_hip_pitch" joint="r_hip_pitch"/>
    <position name="r_knee" joint="r_knee"/>
    <position name="r_ankle" joint="r_ankle"/>
  </actuator>

  <!-- Crouched standing pose (radians in qpos): hip -0.4, knee 0.8, ankle -0.4 keeps the feet flat -->
  <keyframe>
    <key name="home"
         qpos="0 0 0.30  1 0 0 0
               0 -0.4 0.8 -0.4
               0 -0.4 0.8 -0.4"
         ctrl="0 -0.4 0.8 -0.4  0 -0.4 0.8 -0.4"/>
  </keyframe>
</mujoco>
